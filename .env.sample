# ============================================================
# Database
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=graphvis
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ============================================================
# Backend
# ============================================================
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
KEEP_ALIVE_TIMEOUT=86400
NETWORKX_API_URL=http://localhost:8001
# Comma-separated list of allowed CORS origins
# CORS_ORIGINS=http://localhost,http://localhost:5173
# Set to true when serving over HTTPS so auth cookies are HTTPS-only
# COOKIE_SECURE=false
# Log verbosity for backend/networkx-api (DEBUG shows full LLM context dumps,
# which include user conversation content — keep INFO in production)
# LOG_LEVEL=INFO
# --- Container egress network quirks (pick at most ONE, then
#     `docker compose down && docker compose up -d`) ---
# On IPv6-only (NAT64/DNS64) networks where container IPv4 HTTPS breaks,
# uncomment to prefer IPv6 egress:
# PREFER_IPV6_GAI_CONF=./backend/gai.conf
# On networks where container IPv6 is broken at the TLS layer (LLM calls
# time out while plain curl works), disable IPv6 inside the backend container:
# DISABLE_CONTAINER_IPV6=1

# ============================================================
# LLM Provider  (google | anthropic | openai | lmstudio)
# ============================================================
LLM_PROVIDER=google

# --- Google GenAI ---
# Use one of the two authentication methods below, not both.

# Option A: Google AI Studio (API key)
GOOGLE_API_KEY=

# Option B: Vertex AI (Application Default Credentials)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json
# GOOGLE_GENAI_USE_VERTEXAI=TRUE   # Uncomment when using Vertex AI

# Gemini model to use (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
# Thinking budget for Gemini "thinking" models (default: 2048)
# GEMINI_THINKING_BUDGET=2048

# --- Anthropic / Claude ---
# Option A: Anthropic direct API
ANTHROPIC_API_KEY=

# Option B: Claude on Vertex AI
# Reuses VERTEX_PROJECT_ID and GOOGLE_APPLICATION_CREDENTIALS above.
# Region fallback chain: ANTHROPIC_VERTEX_REGION -> VERTEX_LOCATION -> us-east5.
# Override if needed (Anthropic's Opus 4.8 uses global or multi-region like 'us').
ANTHROPIC_VERTEX_REGION=us

# Claude model to use (default: claude-opus-4-8)
CLAUDE_MODEL=claude-opus-4-8
# Max output tokens per Claude response (default: 16000)
# ANTHROPIC_MAX_TOKENS=16000

# --- OpenAI ---
OPENAI_API_KEY=
# OpenAI model to use (default: gpt-5.6-sol)
# OPENAI_MODEL=gpt-5.6-sol

# --- LM Studio (local OpenAI-compatible server) ---
# Start the server and load models in LM Studio. The application discovers the
# chat-capable choices from GET /api/v1/models and shows them in the selector.
# Direct host execution defaults to http://localhost:1234/v1. Docker Compose
# defaults to http://host.docker.internal:1234/v1.
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Optional default when a chat has no pinned LM Studio model.
# LM_STUDIO_MODEL=your-default-model-id
# Only required when authentication is enabled in LM Studio server settings.
# LM_STUDIO_API_KEY=

# ============================================================
# Agent
# ============================================================
# Max ReAct loop iterations per turn (default: 10)
# AGENT_MAX_ITERATIONS=10

# ============================================================
# Frontend
# ============================================================
VITE_API_URL=http://localhost:8000
