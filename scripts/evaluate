#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_PYTHON="$ROOT_DIR/.local/venv/bin/python"

PLAYWRIGHT_CHECK='from pathlib import Path; from playwright.sync_api import sync_playwright; p=sync_playwright().start(); found=Path(p.chromium.executable_path).is_file(); p.stop(); raise SystemExit(0 if found else 1)'

if [ ! -x "$VENV_PYTHON" ] || \
   ! "$VENV_PYTHON" -c "import mcp, playwright" >/dev/null 2>&1 || \
   ! "$VENV_PYTHON" -c "$PLAYWRIGHT_CHECK" >/dev/null 2>&1; then
  "$ROOT_DIR/scripts/setup-evaluation"
fi

cd "$ROOT_DIR"
exec "$VENV_PYTHON" -m evaluation.runner "$@"
